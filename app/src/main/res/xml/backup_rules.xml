<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup cho Android 11 trở xuống (API ≤ 30).
   Không sao lưu token đăng nhập, bản cache dữ liệu và lịch nhắc: chúng gắn với phiên trên máy này,
   khôi phục sang máy khác sẽ dùng lại token của người khác hoặc hiện dữ liệu cũ.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="moodle_session.xml" />
    <exclude domain="sharedpref" path="moodle_reminders.xml" />
    <exclude domain="file" path="bootstrap_cache.json" />
</full-backup-content>
