<?xml version="1.0" encoding="utf-8"?>
<!--
   Sao lưu cloud và chuyển dữ liệu sang máy mới cho Android 12+ (API ≥ 31).
   Cùng quy tắc với backup_rules.xml: không mang token, cache và lịch nhắc sang nơi khác.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="moodle_session.xml" />
        <exclude domain="sharedpref" path="moodle_reminders.xml" />
        <exclude domain="file" path="bootstrap_cache.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="moodle_session.xml" />
        <exclude domain="sharedpref" path="moodle_reminders.xml" />
        <exclude domain="file" path="bootstrap_cache.json" />
    </device-transfer>
</data-extraction-rules>
